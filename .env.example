# SkyShield Docker 发布地址；不配置时使用下列默认值。
PUBLIC_HOST=localhost
PUBLIC_PORT=8443

# 内置反连监控：空值复用 PUBLIC_HOST / PUBLIC_PORT 的 HTTPS 入口。
# 地址必须能从被测目标访问；不要为远程测试配置 localhost。
OAST_PUBLIC_URL=
# 可选独立 HTTP 监听，例如 0.0.0.0:8081；需同时配置相应的公网 URL。
OAST_HTTP_LISTEN=
# 可选权威 DNS：下面三项需一起设置，并完成 NS 委派及 UDP/TCP 53 放行。
# 宿主网络下建议绑定具体接口 IP:53，避免与系统/项目 DNS 服务冲突。
OAST_DNS_LISTEN=
OAST_DNS_ZONE=
OAST_DNS_ANSWER_IP=

# ./docker.sh pull 默认拉取 latest；也可指定已发布的 sha-<提交号> 标签。
SKYSHIELD_IMAGE_TAG=latest

# 默认继承运行 Docker 的 Linux 主机/虚拟机的 DNS、hosts 和代理环境。
# 不会修改宿主机 resolv.conf 或 Docker daemon.json；0 关闭项目网络适配。
SKYSHIELD_INHERIT_HOST_NETWORK=1
# 默认让应用、Agent 和扫描引擎使用 Linux 宿主网络，继承 VPN 路由。
# Postgres、Redis、Loki 仍使用项目网桥；HTTPS 入口仍为 PUBLIC_PORT。
# 宿主模式占用 3000/8080/9090 和 PUBLIC_PORT，仅用于你信任的扫描引擎。
# 若优先需要网桥隔离，可选 bridge；宿主机 VPN/防火墙须允许 Docker 网桥转发。
SKYSHIELD_NETWORK_MODE=host
# 新建项目网络时自动避开已知主机/VPN 路由；也可明确指定未占用网段。
# SKYSHIELD_DOCKER_SUBNET=172.30.240.0/24
# 默认自动选择系统 DNS（优先活动的 systemd-resolved，保留 VPN split DNS）。
# SKYSHIELD_HOST_RESOLV_CONF=/etc/resolv.conf
# HTTP_PROXY、HTTPS_PROXY、ALL_PROXY、NO_PROXY 可在当前 shell 或此文件配置。
# 实际代理凭据保存在 .local/network 的私有文件中，不要提交 .env。

# 数据库、JWT 和 AI 加密密钥由 ./docker.sh 首次启动时生成，
# 保存在 .local/secrets 中。不要将实际密钥写入此文件或提交仓库。
